<div class="bg-white p-4 rounded-lg shadow hover:shadow-md transition">
  <p class="text-gray-800 mb-3"><%= confession.body %></p>

  <div class="flex justify-center space-x-4 mb-2">
    <% ["like", "hug", "laugh"].each do |reaction_type| %>
      <%= button_to confession_reactions_path(confession, reaction_type: reaction_type), method: :post, remote: true, class: "reaction-btn" do %>
        <span data-action="click->reaction#animate" data-reaction-type="<%= reaction_type %>">
          <%= reaction_type == "like" ? "❤️" : reaction_type == "hug" ? "🤗" : "😂" %>
        </span>
      <% end %>
    <% end %>
  </div>

  <div class="flex justify-between items-center text-sm text-gray-500">
    <div id="confession_<%= confession.id %>_reactions">
      💬 <%= confession.reactions.count %> Reactions
    </div>
    <span><%= time_ago_in_words(confession.created_at) %> ago</span>
  </div>
</div>
